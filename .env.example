# OpenAI API Configuration
# Get your API key from https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here

# For Azure OpenAI (if using Azure instead)
# VITE_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# VITE_AZURE_OPENAI_KEY=your_azure_key_here
# VITE_AZURE_OPENAI_DEPLOYMENT=gpt-35-turbo
# VITE_API_VERSION=2024-02-15-preview

# OpenWeather API Configuration
# Get your free API key at: https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google Maps API Configuration
# Get your API key at: https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Satellite Imagery API Configuration (Sentinel Hub)
# Get your API key at: https://www.sentinel-hub.com/
VITE_SATELLITE_API_KEY=your_satellite_api_key_here
